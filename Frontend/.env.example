# -----------------------------------------------------------------------------
# Lumina Cosmetics Store - Production Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to .env.local for local development, or add these variables
# to your production hosting dashboard (e.g. Vercel / Railway / Render).

# -----------------------------------------------------------------------------
# 1. Supabase Database & Auth (REQUIRED)
# -----------------------------------------------------------------------------
# Your Supabase project URL (Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# Service Role Key for backend administrative operations (bypass RLS)
# WARNING: Keep this strictly secret! Never expose to client-side code.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# -----------------------------------------------------------------------------
# 2. Authentication & Security (REQUIRED)
# -----------------------------------------------------------------------------
# High-entropy random secret for signing and verifying JWT tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_min_32_characters

# Cost factor for bcrypt password hashing (default: 12)
BCRYPT_SALT_ROUNDS=12

# Development-only seeder secret. The seed route is always disabled in production.
SEED_SECRET=your_secure_seed_token_here

# Protects Vercel's daily pending-restock notification job (generate a random secret).
CRON_SECRET=your_random_cron_secret_here

# -----------------------------------------------------------------------------
# 3. Application URLs (REQUIRED for production emails & OAuth callbacks)
# -----------------------------------------------------------------------------
# Canonical production site URL without trailing slash (e.g. https://lumina.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Public WhatsApp customer support number with country code (no '+' or dashes)
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567

# Customer-facing support email. Leave either contact setting blank to hide that channel.
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com

# -----------------------------------------------------------------------------
# 4. Email Service (Resend - for email verification & orders)
# -----------------------------------------------------------------------------
# Resend API key (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key

# Verified sender email address
RESEND_FROM_EMAIL="Lumina Store <orders@yourdomain.com>"

# Store administrator email address (receives order and complaint alerts)
ADMIN_EMAIL=admin@yourdomain.com

# -----------------------------------------------------------------------------
# 5. Cloudinary Media Storage (for product image uploads in Admin)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# -----------------------------------------------------------------------------
# 6. OAuth Providers (Optional - for Google / Facebook login)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

